# ==============================================================================
# LCIT Meal Mobile - Mẫu cấu hình biến môi trường (.env.example)
# Sao chép tệp này thành .env: cp .env.example .env
# ==============================================================================

# URL kết nối Backend API thực tế
# - Web / iOS Simulator: http://localhost:3000/api
# - Android Emulator:    http://10.0.2.2:3000/api
# - Thiết bị thật (LAN): http://192.168.x.x:3000/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Chế độ dữ liệu mẫu (Mock Data):
# - false: Kết nối và gọi API backend thực tế (Khuyến nghị)
# - true:  Sử dụng dữ liệu mẫu nội bộ bộ nhớ
EXPO_PUBLIC_USE_MOCK=false

# Thời gian chờ tối đa cho mỗi HTTP request (mili-giây)
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=15000
